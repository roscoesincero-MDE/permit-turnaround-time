            <ZIndex>5</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Tablix>
          <Rectangle Name="AboutPage">
            <ReportItems>
              <Textbox Name="AboutTitle">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Permit Turnaround Performance — About This Report</Value>
                        <Style>
                          <FontSize>14pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Height>0.4in</Height>
                <Width>10.5in</Width>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutRunInfo">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="Reporting period: " &amp; IIf(IsNothing(First(Fields!period_start_date.Value, "Listing")), "no rows were returned for the selected parameters", Format(First(Fields!period_start_date.Value, "Listing"), "MM/dd/yyyy") &amp; " to " &amp; Format(First(Fields!period_end_date.Value, "Listing"), "MM/dd/yyyy"))</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="Program: " &amp; IIf(IsNothing(Parameters!programCode.Value), "All", Parameters!programCode.Label) &amp; "     Permit type: " &amp; IIf(IsNothing(Parameters!permit_type.Value), "All", Parameters!permit_type.Value)</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="Run " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy h:mm:ss tt") &amp; " by " &amp; User!UserID &amp; ". Data is read from ETS at the time the report runs."</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>0.5in</Top>
                <Height>0.7in</Height>
                <Width>10.5in</Width>
                <ZIndex>1</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutSummary">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Summary tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Permits whose approval was ISSUED in the reporting period, whenever the application was received, and that matched a published standard turnaround time. Applications closed without an approval (withdrawn, denied, voided, not required) are not counted here. One row per program, permit category, permit class, permit type, STT permit type and standard turnaround time. STT permit type is not shown as a column, so two rows can carry the same labels.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>program desc — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the ETS program that owns the permit.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>permit category / permit class / permit type — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the permit, as named by the matched standard.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>std turnaround time — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the standard turnaround time, in days, the permits were measured against.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>total qty — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the number of permits issued in the period.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>turnaround time (days) — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the average turnaround time of those permits, to two decimal places. See "How turnaround time is measured" below.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>1.3in</Top>
                <Height>2.4in</Height>
                <Width>10.5in</Width>
                <ZIndex>2</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutStandardReduction">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Standard Reduction tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=&quot;A what-if for the proposal to lower the standard turnaround times by &quot; &amp; Parameters!ReductionPercent.Value &amp; &quot;%. It takes the permits ISSUED in the reporting period, the same permits as the Summary tab, and shows how many of them would have been late if each standard had been &quot; &amp; Parameters!ReductionPercent.Value &amp; &quot;% lower. Nothing in ETS or in the published standards is changed: the tab measures the work already done against a lower target. Change the Standard Reduction % prompt to try a different figure. One row per program, permit category, permit type and standard turnaround time, with the rows the lower standard would affect most at the top.&quot;</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>program desc / permit category / permit type — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the program and the permit, as on the Summary tab. Permits whose standard names no permit type are grouped together as (no permit type).</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>std turnaround time — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>today's standard turnaround time, in days.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>proposed std — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>today's standard less the reduction. It is not rounded: 25% off 90 days is 67.5 days, so a permit that took 68 days counts as late.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>issued qty — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the number of permits issued in the period. It can be a little lower than total qty on the Summary tab, because permits with no turnaround time, or a negative one (approval date before received date in ETS), are left out here. Counted in, they would look on time against any standard.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>late % now — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the share of those permits that took longer than today's standard.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>late % at proposed — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the share that took longer than the proposed standard. The gap between the two columns is how many more permits would be late if the standard were lowered and nothing else changed.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>median days — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>half of the permits were issued within this many days.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>90th percentile days — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>nine out of ten permits were issued within this many days.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>readiness — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>what the lower standard would take, judged from the two columns before it:</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Ready now — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>nine out of ten permits already finish within the proposed standard. It could be adopted now with little risk.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <LeftIndent>18pt</LeftIndent>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Improvement project — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the typical permit already makes it, but the slowest ones do not. Reducing delays on the slow cases would make the lower standard achievable.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <LeftIndent>18pt</LeftIndent>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Redesign needed — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>more than half of the permits would be late. Meeting the lower standard would need a change to how the permit is processed, not just a new target.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <LeftIndent>18pt</LeftIndent>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Read issued qty before readiness: with only a few permits a row can land in any group by chance. Some of a permit's time is required and cannot be cut, such as public notice and comment periods and reviews by other agencies, so a row can show Redesign needed for reasons the program does not control. Turnaround time is measured as on the other tabs; see "How turnaround time is measured" below.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>3.8in</Top>
                <Height>3.9in</Height>
                <Width>10.5in</Width>
                <ZIndex>5</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutDetail">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Detail tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>One row per permit application that matched a published standard and whose application was RECEIVED in the reporting period, OR whose approval was ISSUED in the period, OR which was CLOSED in the period without an approval. An application received and issued in the same period appears once. Because it also includes applications that were only received, or only closed, in the period, its row count will not match the Summary tab's total qty. Nor is it the list of everything pending: that is the Pending tab.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>MASTER AI ID — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the Agency Interest: the regulated site the application is for. Several permits can share one.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>program desc / permit category / permit class / permit type / stt permit type — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the program and the permit, as named by the matched standard.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>project type — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>Major or Minor, where the application records one.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>std turnaround time — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the standard turnaround time, in days, in force on the date the application was received.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>turnaround time (days) — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the turnaround time of this permit. See "How turnaround time is measured" below.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>calendar days qty — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>calendar days from application received to approval issued, or to today if not yet issued.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>application received — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the date the application was received.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>approval issued — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the date the approval was issued; blank if it has not been. For Wetlands and Waterways, the date the report and recommendation was sent to the Board of Public Works, where that has happened.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>INT DOC ID — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the unique ETS identifier of the application.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>7.8in</Top>
                <Height>3.4in</Height>
                <Width>10.5in</Width>
                <ZIndex>3</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutPending">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Pending tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Every permit application that matched a published standard and has been neither issued nor closed, whenever it was received. Unlike the Detail tab it ignores the reporting period, so it is the full list of what is pending today; only the Program, Permit Category and Permit Type chosen narrow it. The most urgent applications come first. The columns are those of the Detail tab, without approval issued, plus:</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>days left — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the standard turnaround time less the turnaround time used so far. Negative means the application is past its standard by that many days.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>% of std used — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the turnaround time used so far as a share of the standard: 75% means three quarters of the standard is gone, 110% means 10% past it. Use it to compare permits with very different standards. Shown in red, with days left, from 100%.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Where the permit type uses the ETS clock, time on hold does not count, so days left stops falling while the clock is paused; otherwise every calendar day counts. Because the count runs to today, the list changes every day.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>11.3in</Top>
                <Height>2.2in</Height>
                <Width>10.5in</Width>
                <ZIndex>7</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutNoPauseResume">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>No Pause-Resume tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Activity types this report measures that have no pause and resume tasks set up for the ETS turnaround clock. ETS pauses the clock when a pause task is completed in the work activity log and restarts it when the matching resume task is completed. An activity type with no such pair cannot have time on hold left out of its turnaround time. The list covers activity types with a New, Renew or Renewal standard in force today, narrowed by the Program, Permit Category and Permit Type chosen. It shows ETS as it is set up today, whatever the reporting period; only the two issued columns use the period.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>program desc / permit category / permit class / permit type — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the program and the permit, as named by the standard. Wetlands Tidal day-count permit types keep the standard&#x27;s own name here (for example 240-Day), so choosing 325-Day or 150-Day as the Permit Type returns no rows on this tab.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>activity type / activity type label — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the ETS activity type code and its name in ETS.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>std turnaround time — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the standard in force today, in days. Two values where the activity type has separate Major and Minor project standards.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>active in ETS — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>No where ETS marks the activity type inactive.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>ETS clock set up — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>Yes where ETS is set up to run the turnaround clock for the activity type at all. No means ETS records no days used for it, so its turnaround time on the other tabs is calendar days.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>issued qty — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>permits of this type issued in the reporting period, counted as on the Summary tab.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>issued with ETS clock qty — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>of those, how many have a days-used figure from the ETS clock.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>last received — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the most recent application received for this type, at any time. Shows whether the type is still in use.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>13.6in</Top>
                <Height>2.8in</Height>
                <Width>10.5in</Width>
                <ZIndex>5</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutPauseResumeTasks">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Pause-Resume Tasks tab</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>The pause and resume tasks set up today for the ETS turnaround clock: one row per pair, for each activity type this report measures, narrowed by the same Program, Permit Category and Permit Type as the No Pause-Resume tab. Task names are the descriptions ETS shows once a task is completed. Older pairs are kept and marked in use = No.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>program desc / permit category / permit class / permit type / activity type / activity type label — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>as on the No Pause-Resume tab.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>pause task id / pause task — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the task that pauses the clock when it is completed.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>resume task id / resume task — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the task that restarts the clock.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>stop task — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>the task that stops the clock for good, normally Approval Issued.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>in use — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>No where ETS marks either task, or the activity type, inactive.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>last updated by / last updated — </Value>
                        <Style>
                          <FontWeight>Bold</FontWeight>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>who last changed the pair in ETS, and when.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>2pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>16.5in</Top>
                <Height>2.2in</Height>
                <Width>10.5in</Width>
                <ZIndex>6</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="AboutMeasures">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>How turnaround time is measured</Value>
                        <Style>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#000000</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Turnaround time (days) is the days used on the ETS turnaround clock wherever ETS has recorded it. ETS pauses that clock while an application is on hold, for example while the department waits for missing information, and restarts it when the hold ends. A pause of one day or more is not counted, so the ETS figure is the time the department had the application, not the time on the calendar. Where ETS has no clock figure, usually because the permit type is not set up to use the clock in ETS, turnaround time is the calendar days from application received to approval issued, or to today for an application not yet issued, so those values grow each day until the permit is issued. A calendar figure includes any time the application was on hold, so the two are not expected to agree. A negative value means the approval date in ETS is earlier than the received date.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Only permits that match a published standard are reported, and only the New, Renew and Renewal permit classes have one. The standard is the one in force on the date the application was received. Applications with a date before 1900 are data-entry errors and are excluded. Applications for the test and functional Agency Interests (MASTER AI IDs) listed in the AI exclusion list, dbo.AiExclusionList, are also excluded; that list is maintained in the database and takes effect the next time the report runs.</Value>
                        <Style>
                          <Color>#333333</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <SpaceAfter>4pt</SpaceAfter>
                    <Style />
                  </Paragraph>
                </Paragraphs>
                <Top>18.8in</Top>
                <Height>1.9in</Height>
                <Width>10.5in</Width>
                <ZIndex>4</ZIndex>
                <Style>
                  <Border>
                    <Style>None</Style>
                  </Border>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>2pt</PaddingTop>
                  <PaddingBottom>2pt</PaddingBottom>
                </Style>
              </Textbox>
            </ReportItems>
            <PageBreak>
              <BreakLocation>End</BreakLocation>
            </PageBreak>
            <PageName>About</PageName>
            <KeepTogether>true</KeepTogether>
            <Height>20.8in</Height>
            <Width>10.5in</Width>
            <ZIndex>2</ZIndex>
            <Visibility>
              <Hidden>=Globals!RenderFormat.IsInteractive</Hidden>
            </Visibility>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>
        </ReportItems>
        <Height>24.64in</Height>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
        </Style>
      </Body>
      <Width>51.25in</Width>
      <Page>
        <PageFooter>
          <Height>0.01042in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
          </Style>
        </PageFooter>
        <LeftMargin>1in</LeftMargin>
        <RightMargin>1in</RightMargin>
        <TopMargin>1in</TopMargin>
        <BottomMargin>1in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
