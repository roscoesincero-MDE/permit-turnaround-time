    <DataSet Name="permitCategory">
      <Query>
        <DataSourceName>ETSProd</DataSourceName>
        <CommandText>
SELECT CAST (NULL AS VARCHAR (30)) AS permit_category
UNION
SELECT DISTINCT s.permit_category
  FROM dbo.stdPermitTT AS s
 WHERE s.IsDeleted = 0
   AND s.permit_category IS NOT NULL
   AND s.permit_class IN ('New', 'Renew', 'Renewal')
ORDER BY permit_category;</CommandText>
      </Query>
      <Fields>
        <Field Name="permit_category">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>permit_category</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="programCode">
      <Query>
        <DataSourceName>ETSProd</DataSourceName>
        <CommandText>
select null as program_code, null as program_desc
union

select

program_code,
program_desc

from

dbo.mtb_program where program_code in 
(
'21',
'26',
'27',
'28',
'29',
'31',
'32',
'33',
'36',
'37'

)</CommandText>
      </Query>
      <Fields>
        <Field Name="program_code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>program_code</DataField>
        </Field>
        <Field Name="program_desc">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>program_desc</DataField>
        </Field>
      </Fields>
    </DataSet>
