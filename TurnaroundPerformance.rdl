    <DataSet Name="permitType">
      <Query>
        <DataSourceName>ETSProd</DataSourceName>
        <CommandText>
SELECT PermitType
FROM (VALUES
	(0, null),
    (1,  '90-Day'),
    (2,  '150-Day'),
    (3,  '240-Day'),
    (4,  '325-Day'),
    (5,  'APA'),
    (6,  'CAFO'),
    (7,  'Charbroilers and Pit Barbecues'),
    (8,  'Chg of Owner'),
    (9,  'Composting Facility'),
    (10, 'Concrete Batch Plant'),
    (11, 'Discharge'),
    (12, 'Distribution'),
    (13, 'Emergency Generators'),
    (14, 'Energy Generation/Incineration'),
    (15, 'General'),
    (16, 'General Collection Facility'),
    (17, 'General Discharge'),
    (18, 'General NOI'),
    (19, 'Groundwater'),
    (20, 'Groundwater Air Strippers and Soil Vapor Extraction'),
    (21, 'GW Remediation Discharge'),
    (22, 'Hauler'),
    (23, 'Incinerator'),
    (24, 'Individual'),
    (25, 'Individual Discharge'),
    (26, 'Industrial Landfill'),
    (27, 'Initial'),
    (28, 'Innovative Project'),
    (29, 'Land App/Reclamation Site'),
    (30, 'Land Application'),
    (31, 'Land Clearing Debris'),
    (32, 'License-GL'),
    (33, 'License-NF'),
    (34, 'License-NL'),
    (35, 'License-PR'),
    (36, 'License-WL'),
    (37, 'LOA'),
    (38, 'MAFO'),
    (39, 'Marketing'),
    (40, 'Medium-Sized Boilers - 10mmbtu&lt; Boilers &lt;40mmbtu'),
    (41, 'Municipal Landfill'),
    (42, 'Non Attainment New Source Review'),
    (43, 'Oil Contaminated Soil'),
    (44, 'Oil Operations'),
    (45, 'Oil Operations - Delivery'),
    (46, 'Oil Operations - Solidification'),
    (47, 'Permit'),
    (48, 'Permit-GP'),
    (49, 'Permit-WP'),
    (50, 'Plan Approvals'),
    (51, 'Prevention of Significant Deterioration'),
    (52, 'Primary Collection Facility'),
    (53, 'Processing Facility'),
    (54, 'Processing Facility and Transfer Station'),
    (55, 'Reclamation Site'),
    (56, 'Recycler'),
    (57, 'Reissue'),
    (58, 'Renewal'),
    (59, 'Research Project'),
    (60, 'Rubble Landfill'),
    (61, 'Secondary Collection Facility'),
    (62, 'Sewage Sludge or Septage Landfill'),
    (63, 'Sheetfed Lithographic Printing'),
    (64, 'Simple'),
    (65, 'Small Fuel Burning (Boiler/Heater) Equipment - &lt;10mmbtu'),
    (66, 'Small Stationary Gasoline Storage Tanks'),
    (67, 'Storage'),
    (68, 'Surface'),
    (69, 'Surface-Groundwater'),
    (70, 'Surface-Major'),
    (71, 'SW Acceptance Facility'),
    (72, 'Synthetic Minor'),
    (73, 'Synthetic Minor-APA'),
    (74, 'Synthetic Minor-Reissue'),
    (75, 'Synthetic Minor-Simple'),
    (76, 'Synthetic Minor-Toxics'),
    (77, 'Temporary'),
    (78, 'Tire Derived Fuel Facility'),
    (79, 'Toxics'),
    (80, 'Transfer Station'),
    (81, 'Transportation'),
    (82, 'Treatment Facility'),
    (83, 'TSD'),
    (84, 'Utilization/Disposal at a Landfill'),
    (85, 'Vehicle Refinishing (Autobody)')
) AS t(SortOrder, PermitType)
ORDER BY SortOrder;</CommandText>
      </Query>
      <Fields>
        <Field Name="PermitType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PermitType</DataField>
        </Field>
      </Fields>
    </DataSet>
